rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Real enforcement of the admin allowlist; keep in sync with ADMIN_EMAILS in frontend/.env.local.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'francoismeiring0203@gmail.com',
             'francoisme@shareforce.net'
           ];
    }

    // Public, read-only portfolio content, writable only by an admin.
    match /portfolio/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /experience/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /education/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /certifications/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /githubProjects/{doc} { allow read: if true; allow write: if isAdmin(); }
    // Client sites, synced from the FM-Web-Studio org by syncStudioSites.mjs.
    match /studioSites/{doc}    { allow read: if true; allow write: if isAdmin(); }

    // A letter from the Connect form, exactly as frontend/src/firebase/contact.js writes it.
    // expireAt feeds the TTL policy that deletes it; the window allows for a visitor's clock being off.
    function isValidContact(d) {
      return d.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['name', 'email', 'message', 'createdAt', 'expireAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() <= 254 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && d.message is string && d.message.size() > 0 && d.message.size() <= 5000
        && d.createdAt == request.time
        && d.expireAt is timestamp
        && d.expireAt > request.time + duration.value(300, 'd')
        && d.expireAt < request.time + duration.value(400, 'd');
    }

    // Contact form: visitors may submit; admin may read and delete.
    match /contacts/{doc}       { allow create: if isValidContact(request.resource.data); allow read, delete: if isAdmin(); allow update: if false; }

    // Everything else is denied by default.
    match /{document=**}        { allow read, write: if false; }
  }
}
