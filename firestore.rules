rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Real enforcement of the admin allowlist; keep in sync with ADMIN_EMAILS in frontend/.env.local.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'francoismeiring0203@gmail.com',
             'francoisme@shareforce.net'
           ];
    }

    // Public, read-only portfolio content, writable only by an admin.
    match /portfolio/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /experience/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /education/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /certifications/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /githubProjects/{doc} { allow read: if true; allow write: if isAdmin(); }
    // Client sites, synced from the FM-Web-Studio org by syncStudioSites.mjs.
    match /studioSites/{doc}    { allow read: if true; allow write: if isAdmin(); }
    // Photo gallery; the image files live in Storage under photos/.
    match /photos/{doc}         { allow read: if true; allow write: if isAdmin(); }

    // Letters arrive only through the sendMessage function, which checks for spam first.
    // The admin may read and delete them. Rate limit records are server only.
    match /contacts/{doc}       { allow read, delete: if isAdmin(); allow create, update: if false; }

    // Everything else is denied by default.
    match /{document=**}        { allow read, write: if false; }
  }
}
