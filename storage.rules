rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same allowlist as firestore.rules; keep the three in sync with ADMIN_EMAILS.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'francoismeiring0203@gmail.com',
             'francoisme@shareforce.net'
           ];
    }

    // Gallery photos: anyone may view, only the admin may add or remove them.
    match /photos/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp|png)');
      allow delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
